# Copy this file to %USERPROFILE%/.dbt/profiles.yml.
# Do not commit the real profiles.yml because it contains your password.
aml_dbt:
  target: dev
  outputs:
    dev:
      type: postgres
      host: localhost
      port: 5432
      user: postgres
      pass: "{{ env_var('DBT_POSTGRES_PASSWORD') }}"
      dbname: aml
      schema: dbt_aml
      threads: 4
      connect_timeout: 10
      keepalives_idle: 0
      sslmode: prefer
